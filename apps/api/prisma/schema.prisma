generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  HR_MANAGER
  RECRUITER
  LINE_MANAGER
  PAYROLL_OFFICER
  ASSET_OFFICER
  EMPLOYEE
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  OFFBOARDING
  EXITED
}

enum RequisitionStatus {
  PENDING_HR
  APPROVED
  REJECTED
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
  OFFER_ACCEPTED
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_HR
  PENDING_MANAGER
}

enum TaxResidency {
  RESIDENT
  NON_RESIDENT
}

enum SensitiveChangeField {
  LEGAL_NAME
  BANK_DETAILS
  NATIONAL_ID_NIN
}

enum OnboardingTaskRole {
  EMPLOYEE
  HR_MANAGER
  ASSET_OFFICER
  LINE_MANAGER
}

enum AttendanceStatus {
  PRESENT_ON_TIME
  PRESENT_GRACE
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  DAY_OFF
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  LOCKED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  LOST
  RETIRED
}

enum AssetAssignmentStatus {
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  RETURNED
}

enum OffboardingExitType {
  RESIGNATION
  CONTRACT_EXPIRY
  TERMINATION
  RETIREMENT
}

enum OffboardingStatus {
  IN_PROGRESS
  CLEARED
}

enum ClearanceTrackType {
  ASSET_RETURN
  OPERATIONAL_HANDOVER
  FINANCE_LOANS
  HR_EXIT
}

enum ClearanceStatus {
  PENDING
  BLOCKED
  CLEARED
}

model User {
  id                           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                        String               @db.VarChar(320)
  passwordHash                 String               @map("password_hash") @db.Text
  role                         UserRole
  isActive                     Boolean              @default(true) @map("is_active")
  mustChangePassword           Boolean              @default(true) @map("must_change_password")
  failedLoginAttempts          Int                  @default(0) @map("failed_login_attempts")
  authzVersion                 Int                  @default(1) @map("authz_version")
  lockedUntil                  DateTime?            @map("locked_until") @db.Timestamptz(6)
  lastLoginAt                  DateTime?            @map("last_login_at") @db.Timestamptz(6)
  deactivatedAt                DateTime?            @map("deactivated_at") @db.Timestamptz(6)
  createdAt                    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee                     Employee?
  refreshTokens                RefreshToken[]
  passwordResetTokens          PasswordResetToken[]
  interviewReviews             InterviewPanelReview[]
  actingDelegationsAsDelegator ActingDelegation[]   @relation("Delegator")
  actingDelegationsAsDelegate  ActingDelegation[]   @relation("Delegate")
  createdAuditLogs             AuditLog[]           @relation("AuditActor")
  behalfAuditLogs              AuditLog[]           @relation("AuditBehalf")
  idempotencyKeys              IdempotencyKey[]
  requisitionsRequested        StaffRequisition[]   @relation("RequisitionRequester")
  requisitionsReviewed         StaffRequisition[]   @relation("RequisitionReviewer")

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Employee {
  id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                        @unique(map: "uq_employees_user_id") @map("user_id") @db.Uuid
  convertedFromOfferId   String?                       @unique(map: "uq_employees_converted_offer") @map("converted_from_offer_id") @db.Uuid
  employeeCode           String                        @unique(map: "uq_employees_employee_code") @map("employee_code") @db.VarChar(30)
  legalName              String                        @map("legal_name") @db.VarChar(160)
  workEmail              String                        @unique(map: "uq_employees_work_email") @map("work_email") @db.VarChar(255)
  personalEmail          String?                       @map("personal_email") @db.VarChar(255)
  phone                  String                        @default("") @map("phone") @db.VarChar(40)
  residentialAddress     String?                       @map("residential_address") @db.Text
  emergencyContactName   String?                       @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone  String?                       @map("emergency_contact_phone") @db.VarChar(40)
  jobTitle               String                        @default("") @map("job_title") @db.VarChar(150)
  employmentType         String                        @default("FULL_TIME") @map("employment_type") @db.VarChar(40)
  departmentId           String                        @default(dbgenerated("'00000000-0000-4000-8000-000000000101'::uuid")) @map("department_id") @db.Uuid
  managerId              String?                       @map("manager_id") @db.Uuid
  workScheduleId         String                        @default(dbgenerated("'00000000-0000-4000-8000-000000000102'::uuid")) @map("work_schedule_id") @db.Uuid
  status                 EmployeeStatus                @default(ONBOARDING)
  taxResidency           TaxResidency                  @default(RESIDENT) @map("tax_residency")
  hireDate               DateTime                      @map("hire_date") @db.Date
  lastWorkingDay         DateTime?                     @map("last_working_day") @db.Date
  baseSalaryUgx          Decimal                       @default(0) @map("base_salary_ugx") @db.Decimal(14, 2)
  recurringAllowancesUgx Decimal                       @default(0) @map("recurring_allowances_ugx") @db.Decimal(14, 2)
  bankName               String?                       @map("bank_name") @db.VarChar(120)
  bankBranch             String?                       @map("bank_branch") @db.VarChar(120)
  bankAccountEncrypted   String?                       @map("bank_account_encrypted") @db.Text
  bankAccountBidx        String?                       @unique(map: "uq_employees_bank_account_bidx") @map("bank_account_bidx") @db.Char(64)
  bankAccountLast4       String?                       @map("bank_account_last4") @db.Char(4)
  ninEncrypted           String?                       @map("nin_encrypted") @db.Text
  ninBidx                String?                       @unique(map: "uq_employees_nin_bidx") @map("nin_bidx") @db.Char(64)
  ninLast4               String?                       @map("nin_last4") @db.Char(4)
  uraTin                 String?                       @map("ura_tin") @db.VarChar(30)
  nssfNumber             String?                       @map("nssf_number") @db.VarChar(30)
  version                Int                           @default(1)
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  department             Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workSchedule           WorkSchedule                  @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  manager                Employee?                     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  directReports          Employee[]                    @relation("EmployeeManager")
  convertedFromOffer     JobOffer?                     @relation("OfferToEmployee", fields: [convertedFromOfferId], references: [id], onDelete: Restrict)
  reportingOffers        JobOffer[]                    @relation("ReportingManager")
  onboardingChecklist    OnboardingChecklist?
  profileChangeRequests  ProfileChangeRequest[]
  performanceReviews     PerformanceReview[]           @relation("ReviewedEmployee")
  reviewsAsManager       PerformanceReview[]           @relation("ReviewManager")
  attendanceRecords      AttendanceRecord[]
  attendanceCorrections  AttendanceCorrectionRequest[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]                @relation("LeaveEmployee")
  leaveHandoverRequests  LeaveRequest[]                @relation("LeaveHandover")
  loans                  StaffLoan[]
  payrollItems           PayrollItem[]
  assetAssignments       AssetAssignment[]
  offboardingCase        OffboardingCase?

  @@map("employees")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}

model ActingDelegation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegatorUserId String   @map("delegator_user_id") @db.Uuid
  delegateUserId  String   @map("delegate_user_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  reason          String   @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  delegator       User     @relation("Delegator", fields: [delegatorUserId], references: [id], onDelete: Restrict)
  delegate        User     @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Restrict)

  @@index([delegatorUserId, isActive], map: "idx_acting_delegations_delegator")
  @@index([delegateUserId, isActive], map: "idx_acting_delegations_delegate")
  @@map("acting_delegations")
}

model Department {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String             @unique @db.VarChar(24)
  name         String             @unique @db.VarChar(120)
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  employees    Employee[]
  requisitions StaffRequisition[]
  offers       JobOffer[]

  @@map("departments")
}

model WorkSchedule {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String             @unique @db.VarChar(120)
  shiftStartTime     DateTime           @default(dbgenerated("'08:00:00'::time")) @map("shift_start_time") @db.Time(6)
  shiftEndTime       DateTime           @default(dbgenerated("'17:00:00'::time")) @map("shift_end_time") @db.Time(6)
  gracePeriodMinutes Int                @default(15) @map("grace_period_minutes")
  workingDaysBitmap  Int[]              @default([1, 2, 3, 4, 5]) @map("working_days_bitmap") @db.SmallInt
  isDefault          Boolean            @default(false) @map("is_default")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  employees          Employee[]
  attendanceRecords  AttendanceRecord[]

  @@map("work_schedules")
}

model PublicHoliday {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holidayDate     DateTime @unique @map("holiday_date") @db.Date
  name            String   @db.VarChar(150)
  year            Int
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("public_holidays")
}

model StatutoryTaxPolicy {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyName              String       @map("policy_name") @db.VarChar(120)
  effectiveFrom           DateTime     @map("effective_from") @db.Date
  effectiveTo             DateTime?    @map("effective_to") @db.Date
  nssfEmployeeRate        Decimal      @map("nssf_employee_rate") @db.Decimal(5, 4)
  nssfEmployerRate        Decimal      @map("nssf_employer_rate") @db.Decimal(5, 4)
  payeResidentBrackets    Json         @map("paye_resident_brackets")
  payeNonResidentBrackets Json         @map("paye_non_resident_brackets")
  lstTiers                Json         @map("lst_tiers")
  lstCollectionMonths     Int[]        @map("lst_collection_months") @db.SmallInt
  isActive                Boolean      @default(true) @map("is_active")
  reviewStatus            String       @default("DRAFT") @map("review_status") @db.VarChar(20)
  legalSourceReference    String?      @map("legal_source_reference") @db.Text
  approvedByUserId        String?      @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdByUserId         String       @map("created_by_user_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  payrollRuns             PayrollRun[]

  @@map("statutory_tax_policies")
}

model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  actorRole        String   @map("actor_role") @db.VarChar(40)
  onBehalfOfUserId String?  @map("on_behalf_of_user_id") @db.Uuid
  action           String   @db.VarChar(80)
  entityType       String   @map("entity_type") @db.VarChar(60)
  entityId         String?  @map("entity_id") @db.Uuid
  oldValues        Json?    @map("old_values")
  newValues        Json?    @map("new_values")
  reason           String?  @db.Text
  ipAddress        String?  @map("ip_address") @db.Inet
  requestId        String?  @map("request_id") @db.Uuid
  checksumSha256   String   @map("checksum_sha256") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor            User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  onBehalfOf       User?    @relation("AuditBehalf", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_audit_logs_actor")
  @@map("audit_logs")
}

model IdempotencyKey {
  key            String   @db.VarChar(128)
  userId         String   @map("user_id") @db.Uuid
  endpoint       String   @db.VarChar(150)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, endpoint, key])
  @@map("idempotency_keys")
}

model StaffRequisition {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisitionCode   String            @unique @map("requisition_code") @db.VarChar(30)
  requestedByUserId String            @map("requested_by_user_id") @db.Uuid
  departmentId      String            @map("department_id") @db.Uuid
  jobTitle          String            @map("job_title") @db.VarChar(150)
  headcount         Int               @default(1)
  employmentType    String            @map("employment_type") @db.VarChar(40)
  justification     String            @db.Text
  targetStartDate   DateTime          @map("target_start_date") @db.Date
  status            RequisitionStatus @default(PENDING_HR)
  reviewedByUserId  String?           @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  decisionReason    String?           @map("decision_reason") @db.Text
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requestedBy       User              @relation("RequisitionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy        User?             @relation("RequisitionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  vacancy           Vacancy?

  @@map("staff_requisitions")
}

model Vacancy {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vacancyCode       String           @unique @map("vacancy_code") @db.VarChar(30)
  requisitionId     String           @unique @map("requisition_id") @db.Uuid
  publishedByUserId String?          @map("published_by_user_id") @db.Uuid
  title             String           @db.VarChar(150)
  location          String           @default("Kampala HQ") @db.VarChar(120)
  description       String           @db.Text
  requirements      String           @db.Text
  salaryBandMinUgx  Decimal?         @map("salary_band_min_ugx") @db.Decimal(14, 2)
  salaryBandMaxUgx  Decimal?         @map("salary_band_max_ugx") @db.Decimal(14, 2)
  closingAt         DateTime         @map("closing_at") @db.Timestamptz(6)
  status            VacancyStatus    @default(DRAFT)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requisition       StaffRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  applications      JobApplication[]

  @@map("vacancies")
}

model JobApplication {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationCode    String            @unique @map("application_code") @db.VarChar(30)
  vacancyId          String            @map("vacancy_id") @db.Uuid
  fullName           String            @map("full_name") @db.VarChar(150)
  applicantEmail     String            @map("applicant_email") @db.VarChar(255)
  phone              String            @db.VarChar(40)
  expectedGrossUgx   Decimal?          @map("expected_gross_ugx") @db.Decimal(14, 2)
  earliestStartDate  DateTime?         @map("earliest_start_date") @db.Date
  coverNote          String            @map("cover_note") @db.Text
  cvStorageKey       String            @map("cv_storage_key") @db.Text
  cvOriginalFilename String            @map("cv_original_filename") @db.VarChar(255)
  cvMimeType         String            @map("cv_mime_type") @db.VarChar(100)
  status             ApplicationStatus @default(APPLIED)
  stageNotes         String?           @map("stage_notes") @db.Text
  submittedAt        DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vacancy            Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  interviews         Interview[]
  offer              JobOffer?

  @@map("job_applications")
}

model Interview {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String         @map("application_id") @db.Uuid
  scheduledAt        DateTime       @map("scheduled_at") @db.Timestamptz(6)
  interviewMode      String         @map("interview_mode") @db.VarChar(40)
  locationOrLink     String         @map("location_or_link") @db.VarChar(255)
  interviewerUserIds String[]       @map("interviewer_user_ids") @db.Uuid
  score              Decimal?       @db.Decimal(4, 2)
  feedback           String?        @db.Text
  outcome            String         @default("SCHEDULED") @db.VarChar(30)
  createdByUserId    String         @map("created_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reviews            InterviewPanelReview[]

  @@map("interviews")
}

model InterviewPanelReview {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId        String    @map("interview_id") @db.Uuid
  reviewerUserId     String    @map("reviewer_user_id") @db.Uuid
  score              Decimal   @db.Decimal(3, 2)
  feedback           String    @db.Text
  recommendation     String    @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  interview          Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer           User      @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([interviewId, reviewerUserId], map: "uq_interview_panel_reviews_reviewer")
  @@map("interview_panel_reviews")
}

model JobOffer {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId        String         @unique @map("application_id") @db.Uuid
  preparedByUserId     String         @map("prepared_by_user_id") @db.Uuid
  offeredJobTitle      String         @map("offered_job_title") @db.VarChar(150)
  departmentId         String         @map("department_id") @db.Uuid
  reportingManagerId   String?        @map("reporting_manager_id") @db.Uuid
  offeredBaseSalaryUgx Decimal        @map("offered_base_salary_ugx") @db.Decimal(14, 2)
  offeredAllowancesUgx Decimal        @default(0) @map("offered_allowances_ugx") @db.Decimal(14, 2)
  proposedStartDate    DateTime       @map("proposed_start_date") @db.Date
  offerExpiresAt       DateTime       @map("offer_expires_at") @db.Timestamptz(6)
  status               OfferStatus    @default(DRAFT)
  approvedByUserId     String?        @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?      @map("approved_at") @db.Timestamptz(6)
  decisionReason       String?        @map("decision_reason") @db.Text
  sentAt               DateTime?      @map("sent_at") @db.Timestamptz(6)
  acceptedAt           DateTime?      @map("accepted_at") @db.Timestamptz(6)
  offerPdfStorageKey   String?        @map("offer_pdf_storage_key") @db.Text
  responseTokenHash    String?        @unique(map: "uq_job_offers_response_token_hash") @map("response_token_hash") @db.Char(64)
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  application          JobApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department           Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportingManager     Employee?      @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: Restrict)
  employee             Employee?      @relation("OfferToEmployee")

  @@map("job_offers")
}

model OnboardingChecklist {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String           @unique @map("employee_id") @db.Uuid
  status      String           @default("IN_PROGRESS") @db.VarChar(20)
