# Local host development only. Do not reuse these values in deployed environments.
NODE_ENV=development
TZ=Africa/Kampala
PORT=4000
DATABASE_URL=postgresql://staffhub:staffhub_local_only@localhost:5432/staffhub?schema=public
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost
DEMO_MODE=false
JWT_ACCESS_SECRET=replace-with-a-random-local-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-local-development-secret
CSRF_HMAC_SECRET=replace-with-an-independent-random-local-development-secret
PII_ENCRYPTION_KEY=replace-with-a-local-32-byte-key
CRON_SHARED_SECRET=replace-with-a-random-local-development-secret
